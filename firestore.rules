rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(uid) {
      return hasVerifiedEmail() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isVerifiedOwner(uid);

      match /backups/{docId} {
        allow read, create, update, delete: if isVerifiedOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
